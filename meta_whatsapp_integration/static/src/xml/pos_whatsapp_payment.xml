<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="pos_whatsapp_button" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">

    <xpath expr="//div[hasclass('payment-buttons')]" position="after">

        <div style="margin-top: 15px;">
            <input type="text"
                   placeholder="Enter WhatsApp Number"
                   t-model="state.whatsappNumber"
                   style="width:70%; padding:8px;" />

            <button class="button"
                    style="margin-left:10px;"
                    t-on-click="sendWhatsAppReceipt">
                📱 Send WhatsApp
            </button>
        </div>

    </xpath>

</t>

</templates>