<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Send WhatsApp Message Wizard Form -->
    <record id="view_send_whatsapp_message_form" model="ir.ui.view">
        <field name="name">send.whatsapp.message.form</field>
        <field name="model">send.whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <group name="recipient_info">
                        <field name="business_account_id"/>
                        <field name="partner_id"/>
                        <field name="to_number"/>
                        <field name="message_type" widget="radio"/>
                    </group>
                </group>
                
                <group invisible="not show_text_field">
                    <field name="message_text" nolabel="1" placeholder="Enter your message here..."/>
                </group>

                <group invisible="not show_template_field">
                    <group>
                        <field name="template_id" domain="[('status', '=', 'APPROVED')]"/>
                        <field name="template_parameters" placeholder="param1, param2, param3"/>
                    </group>
                    <group>
                        <field name="template_preview" nolabel="1" readonly="1"/>
                    </group>
                </group>
                
                <footer>
                    <button string="Send Message" name="action_send_message" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Menu -->
    <record id="action_send_whatsapp_message_menu" model="ir.actions.act_window">
        <field name="name">Send WhatsApp Message</field>
        <field name="res_model">send.whatsapp.message</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>